@model PadillaG_Liga_Pro.Models.Equipo

@{
    ViewData["Title"] = "Crear Nuevo Equipo";
}

<h1>Crear Nuevo Equipo</h1>
<hr />

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="Nombre" class="control-label">Nombre del Equipo</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="partidosJugados" class="control-label">Partidos Jugados</label>
        <input asp-for="partidosJugados" class="form-control" type="number" />
        <span asp-validation-for="partidosJugados" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="partidosGanados" class="control-label">Partidos Ganados</label>
        <input asp-for="partidosGanados" class="form-control" type="number" />
        <span asp-validation-for="partidosGanados" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="partidosEmpatados" class="control-label">Partidos Empatados</label>
        <input asp-for="partidosEmpatados" class="form-control" type="number" />
        <span asp-validation-for="partidosEmpatados" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="partidosPerdidos" class="control-label">Partidos Perdidos</label>
        <input asp-for="partidosPerdidos" class="form-control" type="number" />
        <span asp-validation-for="partidosPerdidos" class="text-danger"></span>
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-success">Crear Equipo</button>
        <a href="@Url.Action("Index")" class="btn btn-primary">Volver al listado</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
